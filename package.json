{
  "name": "chromesthesia-visualizer",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run start -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run start -w client",
    "dev:server": "npm run dev -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
