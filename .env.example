# For docker compose only (local development uses server/.env and client/.env).
# Copy to .env next to docker-compose.yml and fill in.

# From https://developer.spotify.com/dashboard. Register this site's origin
# (e.g. https://colors.example.com, no trailing slash) as a redirect URI there.
VITE_SPOTIFY_CLIENT_ID=

# Run `npm run hash-password -w server` and paste both lines it prints.
OWNER_PASSWORD_HASH=
SESSION_SECRET=

# Optional
# DB_NAME=colordatabase
# PORT=5050
