# Copy to server/.env and fill in.
CONNECTION_STRING=mongodb://127.0.0.1:27017
DB_NAME=colordatabase
PORT=5050

# Owner login. Run `npm run hash-password -w server` and paste both lines it prints.
# Only the password's hash is stored; changing SESSION_SECRET logs out every device.
OWNER_PASSWORD_HASH=
SESSION_SECRET=

# Set to true in production behind Cloudflare Tunnel, so failed logins are counted per visitor.
# Leave it off anywhere the server can be reached without going through Cloudflare.
TRUST_CLOUDFLARE=false
